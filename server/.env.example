# -----------------------------------------------------------------------------
# Avri Energy API. Copy to `.env` and fill in. Never commit `.env`.
#
# Unlike client/.env, everything here is server-side and genuinely secret —
# database password, JWT signing key, SMTP credentials.
# -----------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Origin of this API as the outside world sees it. Used to build absolute URLs
# for uploaded images, and in the links inside notification emails.
PUBLIC_API_URL="http://localhost:4000"

# Origin of the public website, for "view this on the site" links.
PUBLIC_SITE_URL="http://localhost:3000"

# Browser origins allowed to call this API, comma separated. The public site
# and the admin panel. Anything not on this list is refused by CORS.
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# --- Database ----------------------------------------------------------------
DB_HOST="127.0.0.1"
DB_PORT=3306
DB_USER="avri"
DB_PASSWORD=""
DB_NAME="avri_energy"
DB_CONNECTION_LIMIT=10

# Same connection, in URL form. drizzle-kit reads this one.
DATABASE_URL="mysql://avri:@127.0.0.1:3306/avri_energy"

# --- Auth --------------------------------------------------------------------
# Sign the admin session token. At least 32 characters. Generate with:
#   openssl rand -base64 48
# Changing it logs every admin out.
JWT_SECRET=""
JWT_EXPIRES_IN="8h"
COOKIE_NAME="avri_admin"

# Leave blank in development. In production set it only if the admin panel and
# the API are on different subdomains of the same site (".avrienergy.com").
# With the admin served at avrienergy.com/admin they share an origin and this
# should stay blank.
COOKIE_DOMAIN=""

BCRYPT_ROUNDS=12

# --- Storage -----------------------------------------------------------------
# Where résumés and uploaded images are written.
#
# IMPORTANT: in production point this OUTSIDE the deployed code (for example
# /var/lib/avri/storage). If it sits inside the deploy directory, a rebuild or
# a fresh `git clone` will orphan or destroy every résumé ever submitted.
STORAGE_ROOT="./storage"

MAX_RESUME_BYTES=5242880
MAX_IMAGE_BYTES=3145728

# Refuse new applications when the disk drops below this, so an upload flood
# cannot fill the volume and take the whole site down.
MIN_FREE_DISK_BYTES=2147483648

# --- Email (Gmail SMTP) ------------------------------------------------------
# Requires 2-Step Verification on the account and a 16-character App Password
# (https://myaccount.google.com/apppasswords) — Google removed "less secure app
# access" years ago.
#
# Use a Google Workspace mailbox on avrienergy.com, NOT a personal @gmail.com:
# Gmail rewrites the From header to the authenticated mailbox, so a personal
# address means mail appears to come from that person and SPF/DKIM will not
# align with your domain. That is a fast route to the spam folder.
#
# Set MAIL_ENABLED=false in development: nothing is sent, and each row is
# recorded as "skipped" rather than "failed".
MAIL_ENABLED=false
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM_NAME="Avri Energy Website"
MAIL_FROM="website@avrienergy.com"

# Who receives what.
MAIL_HR_TO="careers@avrienergy.com"
MAIL_SALES_TO="sales@avrienergy.com"
MAIL_BCC=""

# Send applicants a "we have your application" acknowledgement.
MAIL_ACK_ENABLED=true

# --- Revalidation ------------------------------------------------------------
# Publishing a post or a job calls this so the public page updates immediately
# instead of waiting for ISR. Must match REVALIDATE_SECRET in client/.env.
REVALIDATE_URL="http://localhost:3000/api/revalidate"
REVALIDATE_SECRET=""

# --- Rate limiting -----------------------------------------------------------
# Only turn off for local load testing.
RATE_LIMIT_ENABLED=true

# Number of reverse proxies in front of this app. 0 when running directly,
# 1 behind a single nginx. Getting this wrong makes every request look like it
# came from the proxy, so one bot would rate-limit everybody.
TRUST_PROXY=0

# --- First-run bootstrap -----------------------------------------------------
# Prefer `npm run admin:create`, which prompts and never puts the password in a
# file. These are for an unattended first boot; the account is forced to change
# its password on first login. Delete them once the admin exists.
SEED_ADMIN_NAME=""
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
