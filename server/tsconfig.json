{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true,
    "types": ["node"]
  },
  // `migrations/`, `seeders/` and `config/config.cjs` are deliberately absent:
  // sequelize-cli loads them with `require` and they never go through tsc.
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "migrations", "seeders"]
}
