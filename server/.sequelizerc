/**
 * Tells sequelize-cli where things live.
 *
 * Migrations and seeders stay outside `src/` and are plain CommonJS: the CLI
 * loads them with `require` and never goes through TypeScript, so compiling
 * them into `dist/` would only mean two copies to keep in step.
 */

const path = require("node:path");

module.exports = {
  config: path.resolve(__dirname, "config", "config.cjs"),
  "migrations-path": path.resolve(__dirname, "migrations"),
  "seeders-path": path.resolve(__dirname, "seeders"),
  "models-path": path.resolve(__dirname, "src", "models"),
};
