# -----------------------------------------------------------------------------
# Admin panel configuration.
#
# There are no secrets here, and that is by design: the session is an httpOnly
# cookie set by the API, so this app never handles a token.
# -----------------------------------------------------------------------------

# Where the Next server reaches the API. Server-only — it is used by the
# /api/* rewrite in next.config.ts and by server actions, and never reaches
# the browser bundle. Keep it on the loopback in production.
API_ORIGIN="http://127.0.0.1:4000"

# Must match COOKIE_NAME in ../server/.env — proxy.ts checks for it by name.
COOKIE_NAME="avri_admin"
