NEXT_PUBLIC_EMAIL="info@avrienergy.com"
NEXT_PUBLIC_PHONE="+91 89790 94813"
NEXT_PUBLIC_WHATSAPP="918979094813"
NEXT_PUBLIC_ADDRESS="Office No. 3, Aurangabad Gadana, Modinagar, Ghaziabad, Uttar Pradesh – 201204"
NEXT_PUBLIC_GOOGLE_MAP="https://www.google.com/maps?q=Aurangabad%20Gadana%2C%20Modinagar%2C%20Ghaziabad%2C%20Uttar%20Pradesh%20201204&output=embed"

# PIN code, kept separate because it cannot be reliably pulled out of the
# address by splitting on commas - and Google's JobPosting schema wants a
# proper PostalAddress for the careers pages to be eligible.
NEXT_PUBLIC_POSTAL_CODE="201204"

# --- Social media ------------------------------------------------------------
NEXT_PUBLIC_FACEBOOK=""
NEXT_PUBLIC_LINKEDIN=""
NEXT_PUBLIC_INSTAGRAM=""
NEXT_PUBLIC_YOUTUBE=""
NEXT_PUBLIC_TWITTER=""

# --- Additional company details ----------------------------------------------
NEXT_PUBLIC_TAGLINE="Reliable Power. Trusted Partner."
NEXT_PUBLIC_COMPANY_LEGAL_NAME="AVRI ENERGY PRIVATE LIMITED"
NEXT_PUBLIC_COMPANY_DESCRIPTION="Avri Energy is an electrical EPC and renewable energy company delivering turnkey HT & LT works, substations, transformers, smart metering, solar and EV charging infrastructure across India."
