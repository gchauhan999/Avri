NEXT_PUBLIC_HOURS_WEEKEND="Sunday, Closed"

NEXT_PUBLIC_SITE_URL="https://www.avrienergy.com"

# --- API ---------------------------------------------------------------------
# The Avri API (see ../server) backs the contact and quote forms, the careers
# section, the blog and the client list.
#
# Replaces the old NEXT_PUBLIC_ENQUIRY_ENDPOINT, which pointed at a third-party
# form service and was never filled in — enquiries reached nobody.

# How the BROWSER reaches the API. Forms POST here, so it is compiled into the
# page and is not a place for anything secret.
NEXT_PUBLIC_API_URL="http://localhost:8000"

# How this NEXT SERVER reaches the API when rendering a page. Keep it on the
# loopback in production so a render does not leave the machine. Not a
# NEXT_PUBLIC_ value: it never reaches the browser.
API_INTERNAL_URL="http://127.0.0.1:8000"

# Shared secret guarding /api/revalidate. The server calls that route when an
# article or job is published so the page updates without waiting for ISR.
# Must match REVALIDATE_SECRET in ../server/.env. Generate with:
#   openssl rand -base64 32
REVALIDATE_SECRET=""
