APP_NAME="Avri Energy"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database ----------------------------------------------------------------
# The schema this application inherits: admin_users, jobs, applications,
# post_categories, posts, clients, enquiries.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=avri_energy
DB_USERNAME=root
DB_PASSWORD="change-me"
# The existing tables are utf8mb4_0900_ai_ci. Laravel would otherwise create
# new ones as utf8mb4_unicode_ci, and a join across two collations fails.
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_0900_ai_ci

# Not the framework default of `jobs` — that name belongs to the job openings.
DB_QUEUE_TABLE=queue_jobs

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Notifications are sent after the response, so a dead SMTP server never makes
# a visitor wait on a form they have already submitted.
QUEUE_CONNECTION=database

CACHE_STORE=database

# --- The public website ------------------------------------------------------
# Where the Next.js site lives. Used for absolute links in notification emails
# and for the cache-refresh ping below.
PUBLIC_SITE_URL=http://localhost:3000
# Browser origins allowed to call this API. Anything else is refused by CORS.
CORS_ORIGINS=http://localhost:3000

# Publishing an article or a job pings this so the page updates immediately
# instead of waiting for the site's own revalidation window. Must match
# REVALIDATE_SECRET in ../client/.env. The trailing slash matters: the site
# sets trailingSlash, and without it every ping costs a redirect.
REVALIDATE_URL=http://localhost:3000/api/revalidate/
REVALIDATE_SECRET="change-me"

# --- Uploads -----------------------------------------------------------------
# Résumés are private and reachable only through an authenticated download.
# Images are public. Both live under storage/app.
MAX_RESUME_BYTES=5242880
MAX_IMAGE_BYTES=3145728
MIN_FREE_DISK_BYTES=2147483648

# --- Email -------------------------------------------------------------------
# `log` writes messages to storage/logs instead of sending them, which is the
# right default locally. Switch MAIL_MAILER to smtp when credentials exist.
MAIL_MAILER=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="info@avrienergy.com"
MAIL_FROM_NAME="Avri Energy Website"
# Who hears about a new application, and who hears about a new enquiry.
MAIL_HR_TO=careers@avrienergy.com
MAIL_SALES_TO=sales@avrienergy.com
MAIL_BCC=
# Send the applicant a "we have it" acknowledgement as well.
MAIL_ACK_ENABLED=true

VITE_APP_NAME="${APP_NAME}"
