# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
#
# This is a three-workspace repo (client / server / admin), so every pattern
# below is deliberately unanchored — a leading slash would only match the root
# and miss `client/.next`, `server/dist` and so on.

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js — client/ and admin/ each build into their own .next
.next/
out/

# production
build/
dist/

# uploaded files: résumés, client logos and blog covers. Never in git — they
# are user data, and résumés are personal data. See server/README.md for the
# backup story.
server/storage/
server/uploads/

# misc
.DS_Store
*.pem

# archives — site backups and export bundles are build artefacts, not source
*.zip

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but keep the documented templates in version control
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
