# Apache configuration for the exported site (cPanel and similar shared hosts).
#
# This file lives in `public/`, so `next build` copies it into `out/` and it
# survives every rebuild. Upload it along with the rest of the folder.
#
# NOTE: a rule like `RewriteRule ^ index.html [L]` is often suggested for
# single-page apps. Do NOT use it here. This is a multi-page export: every
# route is a real directory with its own index.html, so Apache already serves
# them. That rule would hand the homepage to every unmatched URL and the 404
# page would never appear.

# Serve the exported 404 page instead of Apache's default.
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# Hashed assets never change contents, so they can be cached indefinitely.
# Everything else is revalidated, so a redeploy is picked up immediately.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|jpg|jpeg|png|svg|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt|json)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json image/svg+xml
</IfModule>

# Directory listings off — nobody should be able to browse /assets/.
Options -Indexes
